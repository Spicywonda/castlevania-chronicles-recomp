+    private static void CaptureSamples()
+    {
+        if (_capture == null) return;
+        try
+        {
+            var bytes = System.Runtime.InteropServices.MemoryMarshal.AsBytes(_sampleBuf.AsSpan());
+            var count = Math.Min(bytes.Length, _captureBytesLeft);
+            _capture.Write(bytes[..count]);
+            _captureBytesLeft -= count;
+            var second = (44100 * 4 * 60 - _captureBytesLeft) / (44100 * 4);
+            if (second != _lastCaptureSecond)
+            {
+                _lastCaptureSecond = second;
+                File.WriteAllText("audio-timing.json", System.Text.Json.JsonSerializer.Serialize(new
+                { Seconds = second, MaxProcessedBuffers = _maxProcessed, SourceRestarts = _restarts,
+                    Spu = _spu?.CaptureAudioTiming() }, new System.Text.Json.JsonSerializerOptions { WriteIndented = true }));
+            }
+            if (_captureBytesLeft == 0)
+            {
+                _capture.Dispose();
+                _capture = null;
+                _spu?.SaveAudioBlockTrace();
+                Console.WriteLine("[audio] 60-second PCM and block trace capture complete");
+            }
+        }
+        catch (IOException e)
+        {
+            Console.Error.WriteLine($"[audio] capture disabled: {e.Message}");
+            _capture?.Dispose();
+            _capture = null;
+        }
+    }
 
