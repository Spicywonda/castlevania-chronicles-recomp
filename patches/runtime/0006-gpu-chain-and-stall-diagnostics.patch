--- /dev/null
+++ b/RecompOne.Runtime/Gpu/GpuWorkDiagnostics.cs
@@ -0,0 +1,10 @@
+namespace RecompOne.Runtime;
+
+// Approximate, lock-free breadcrumbs: sampling must work while rendering is stuck.
+public static class GpuWorkDiagnostics
+{
+    public static volatile int ReplayIndex, ReplayCount;
+    public static volatile string ReplayOperation = "idle";
+    public static long FlushStarted, FlushCompleted;
+    public static string Describe() => $"replay={ReplayIndex}/{ReplayCount} op={ReplayOperation} flushStarted={Interlocked.Read(ref FlushStarted)} flushCompleted={Interlocked.Read(ref FlushCompleted)}";
+}
