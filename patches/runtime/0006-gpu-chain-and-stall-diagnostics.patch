diff --git a/RecompOne.Runtime/Memory/GpuPacketChain.cs b/RecompOne.Runtime/Memory/GpuPacketChain.cs
new file mode 100644
--- /dev/null
+++ b/RecompOne.Runtime/Memory/GpuPacketChain.cs
@@ -0,0 +1,34 @@
+using System.Buffers;
+
+namespace RecompOne.Runtime.Memory;
+
+// A PS1 DMA list may visit each RAM word once. Repeating a header cannot
+// make progress: reject it before replaying another copy of its GPU commands.
+internal sealed class GpuPacketChain : IDisposable
+{
+    private readonly uint _start;
+    private readonly uint[] _seen;
+    private int _packets;
+    private readonly int _length;
+
+    public GpuPacketChain(uint start)
+    {
+        _start = start & Runtime.RamWordMask;
+        _length = checked((int)((Runtime.RamWordMask >> 7) + 1));
+        _seen = ArrayPool<uint>.Shared.Rent(_length);
+        Array.Clear(_seen, 0, _length);
+    }
+
+    public void Visit(uint address)
+    {
+        address &= Runtime.RamWordMask;
+        var index = (int)(address >> 7);
+        var bit = 1u << (int)((address >> 2) & 31);
+        if ((_seen[index] & bit) != 0)
+            throw new InvalidOperationException($"cyclic GPU packet chain: start=0x{_start:X8} repeated=0x{address:X8} packets={_packets}");
+        _seen[index] |= bit;
+        _packets++;
+    }
+
+    public void Dispose() => ArrayPool<uint>.Shared.Return(_seen);
+}
diff --git a/RecompOne.Runtime/Gpu/GpuWorkDiagnostics.cs b/RecompOne.Runtime/Gpu/GpuWorkDiagnostics.cs
